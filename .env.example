# Copy to .env (docker compose reads it automatically). All values are optional.

# Claude-powered document summaries and search keywords. Leave empty for the offline thesaurus/extractive mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Require this value in the X-API-Key header on every request (docs and health stay public).
API_KEY=

# Documents whose semantic similarity to the query is below this are dropped unless they match lexically.
# MIN_DOCUMENT_SIMILARITY=0.55
